{
  "schema_version": "0.1",
  "prompt": "i wonder what the optimal drawdown is to buy into TQQQ over the past 20 years",
  "template": "drawdown_entry",
  "universe": {
    "assets": [
      {
        "symbol": "TQQQ",
        "security_id": "tqqq",
        "synthetic_extension": {
          "recipe_id": "tqqq_from_qqq_3x",
          "underlying": "QQQ",
          "leverage": 3,
          "annual_fee_pct": 0.95,
          "borrow_spread_pct": 0.5
        }
      }
    ],
    "price_adjustment": "split_only"
  },
  "date_range": { "start": "2006-10-23", "end": "2026-10-21", "warmup_days": 0 },
  "capital": { "initial": 10000, "currency": "USD" },
  "costs": { "commission_per_trade": 0, "slippage_bps": 5 },
  "cash": { "yield": "none" },
  "execution": { "fill": "next_close" },
  "strategy": {
    "template": "drawdown_entry",
    "reference": { "type": "all_time_high" },
    "entry": {
      "style": "single",
      "threshold_pct": { "sweep": { "min": 10, "max": 80, "step": 5 } },
      "position_pct": 100
    },
    "exit": { "rules": [ { "type": "recover_to_high" } ] },
    "reentry": true
  },
  "objective": { "metric": "cagr", "min_trades": 3 },
  "benchmarks": ["TQQQ", "QQQ"],
  "robustness": { "oos_split": "2018-10-22", "regime_breakdown": true, "parameter_surface": true },
  "provenance": {
    "/template": { "source": "inferred", "quote": "optimal drawdown to buy into", "note": "Entry triggered by a drawdown level." },
    "/universe/assets/0/symbol": { "source": "stated", "quote": "TQQQ" },
    "/universe/assets/0/synthetic_extension": { "source": "inferred", "note": "TQQQ's real data starts on 2010-02-11. 2006-10 to 2010-02 is simulated as 3x QQQ by recipe tqqq_from_qqq_3x, whose validation over 2010-2026 is a daily correlation of 0.999 and a tracking difference of +0.53% a year. Told to the user before the run." },
    "/date_range/start": { "source": "stated", "quote": "past 20 years" },
    "/date_range/end": { "source": "inferred", "note": "The latest bar held." },
    "/date_range/warmup_days": { "source": "default", "note": "0 loads all earlier history as warmup, so the all-time high includes the simulated 2000 peak, which TQQQ did not regain for years. That changes every result; worth saying." },
    "/strategy/reference": { "source": "stated", "note": "Answered in follow-up.", "options": ["all_time_high", "rolling_high (52-week)", "since_last_exit"] },
    "/strategy/entry/threshold_pct": { "source": "inferred", "quote": "optimal drawdown", "note": "'Optimal' read as: sweep the threshold." },
    "/strategy/exit/rules": { "source": "stated", "note": "Answered in follow-up.", "options": ["hold forever", "sell when it regains the old high", "trailing stop", "take profit"] },
    "/objective/metric": { "source": "stated", "note": "Answered in follow-up.", "options": ["cagr", "sharpe", "calmar", "max_drawdown"] },
    "/benchmarks": { "source": "default", "note": "The asset itself (simulated years included), and the index it leverages." },
    "/robustness/oos_split": { "source": "default", "note": "60% of the range." },
    "/cash/yield": { "source": "default", "note": "No interest on cash while waiting: the job does not pay a cash yield yet. Understates a strategy that sits in cash." }
  }
}
