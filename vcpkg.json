{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "marketscan",
  "version": "0.1.0",
  "description": "Quantitative trading research platform. One engine for backtest, paper and live.",
  "homepage": "https://github.com/ckirby04/MarketScan",
  "license": "MIT",
  "builtin-baseline": "1577f17ee57f42a0ef6d75bbb82cb37d0b76d7e8",
  "dependencies": [
    "nlohmann-json",
    "spdlog",
    "catch2"
  ],
  "features": {
    "gui": {
      "description": "Dear ImGui + ImPlot native dashboard (GLFW + OpenGL3)",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "glfw-binding",
            "opengl3-binding"
          ]
        },
        "implot",
        "glfw3"
      ]
    },
    "python": {
      "description": "pybind11 bindings for headless research",
      "dependencies": [
        "pybind11"
      ]
    }
  }
}
