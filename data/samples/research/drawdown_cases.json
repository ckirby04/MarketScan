    { "name": "no reserve, so gap-ups are refused", "start": "2000-01-03", "starting_cash": 10000, "spread_bps": 2.0, "commission": 5.0, "reserve": 0.0,
      "tranches": [[5, 100]], "trailing_stop": 3 },
