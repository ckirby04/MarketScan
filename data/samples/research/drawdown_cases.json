      "tranches": [[0, 100]] },
    { "name": "a long rolling window and a stop loss", "start": "2000-01-03", "starting_cash": 10000, "spread_bps": 2.0, "commission": 0.0, "reserve": 2.0,
      "reference": "rolling_high", "window": 504, "tranches": [[25, 100]], "stop_loss": 20, "recover_to_high": true },
    { "name": "two tranches on one bar become one order", "start": "2000-01-03", "starting_cash": 10000, "spread_bps": 2.0, "commission": 0.0, "reserve": 2.0,
