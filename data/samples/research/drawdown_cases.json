      "tranches": [[10, 40], [25, 30], [40, 30]], "time_stop": 60, "recover_to_high": true },
    { "name": "no re-entry after the first exit", "start": "2000-01-03", "starting_cash": 10000, "spread_bps": 2.0, "commission": 0.0, "reserve": 2.0,
