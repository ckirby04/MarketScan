    "form": "contracts/research/strategy_form.schema.json",
    "results": "contracts/research/results.schema.json",
    "catalog": "contracts/research/catalog_records.schema.json"
  },
  "bases": {
    "form_example": "contracts/research/examples/tqqq_drawdown.json",
    "results_fixture": "data/samples/research/results_fixture.json"
  },
