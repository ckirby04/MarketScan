# --- Build output ---
build/
out/
cmake-build-*/
install/
_deps/

# --- vcpkg ---
vcpkg_installed/
.vcpkg-root

# --- Visual Studio / MSVC ---
.vs/
*.user
*.suo
*.vcxproj*
*.sln
*.pdb
*.ilk
*.idb
*.exp
*.obj

# --- Runtime / local state ---
imgui.ini
*.log
logs/

# --- Secrets: never commit ---
#
# Added BEFORE the first credential existed, which is the only time adding them
# is free. Broker keys come from the environment and from nowhere else; see
# docs/DATA_POLICY.md and include/marketscan/live/credentials.hpp.
#
# scripts/check_no_secrets.py enforces this in CI, because a gitignore is a
# convenience that one `git add -f` defeats.
.env
.env.*
*.key
*.pem
secrets.json
credentials.json
alpaca.json
alpaca.toml
broker.json
*.credentials

# --- Market data: never commit anything but the curated samples ---
data/*
!data/samples/
!data/security_overrides.csv
!data/identity_calibration.csv
data/samples/*
!data/samples/*.csv
!data/samples/README.md
# Research fixtures: hand-written JSON and a seeded synthetic price path. No market data.
!data/samples/research/

# --- Research runs: written by the Research view, one directory each ---
runs/

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# .pytest_cache was already ignored, but only because pytest writes its own
# .gitignore inside it. That is a third-party tool's incidental behaviour
# standing in for one of our rules, and it looks identical to being properly
# ignored right up until a pytest release stops doing it. Named explicitly.
.pytest_cache/

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# --- Fetched market data: cache only, never committed ---
data/cache/

# --- Live stream recordings ---
#
# A recording is real market data under a subscriber agreement. It is never
# committed, whatever it is called or wherever someone puts it. See
# docs/DATA_POLICY.md section 7.
#
# The equivalence test writes to a temporary directory and deletes what it
# wrote; these patterns are for the times somebody passes --out into the repo
# to look at a divergence, which is a reasonable thing to do and must not end
# in a commit.
*.ndjson
data/recordings/
recordings/

